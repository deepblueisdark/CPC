# ==========================================================
# .gitignore — CPC
#
# Nota: o .gitignore antigo continha a linha "cpc.config", mas o
# arquivo estava rastreado no repositorio (foi commitado antes da
# regra existir), o que tornava a regra inocua e enganosa. O
# cpc.config voltou a ser rastreado de forma explicita: ele nao
# tem segredos, so caminhos, e documenta os equivalentes Linux.
# ==========================================================

# --- saidas geradas (mantem a pasta, ignora o conteudo) ---
SAIDAS/**
!SAIDAS/.gitkeep
!SAIDAS/*/.gitkeep

# --- diretorio de trabalho da rotina diaria ---
# Espelha o OPERA/ do servidor: planilhas acumuladoras, logs e
# graficos por bacia. Pesado e mutavel, fica fora do git.
OPERA/**
!OPERA/.gitkeep
graficos_bacias/
graficos_bacias_NFE/
log_cpc.txt
cron.log

# --- backups da consolidacao ---
_backup/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- dados brutos e intermediarios ---
*.nc
*.xlsx
tmp_cpc_bin/

# --- shapefiles: dado operacional, vive fora do repositorio ---
SHAPES/
*.shp
*.shx
*.dbf
*.prj
*.cpg

# --- windows / onedrive ---
desktop.ini
Thumbs.db
*.lnk

# ==========================================================
# Identidade do ambiente e espelho da producao
# ==========================================================
# Este repositorio e PUBLICO. Nada que diga onde a producao roda —
# servidor, usuario, hostname, layout de diretorios — entra aqui.
#
# cpc.local guarda esses valores e fica so na maquina. O modelo
# rastreado e cpc.local.example.
cpc.local

# _producao/ e o espelho verbatim do OPERA/ do servidor, e
# _legado/servidor/ sao copias verbatim de lá: os dois carregam
# caminhos e configs reais da producao. Vivem locais, fora do git.
_producao/
_legado/servidor/

# cpc.config carrega caminhos desta maquina; o modelo rastreado e
# cpc.config.example. Ver a nota sobre identidade do ambiente acima.
cpc.config
