# Auto detect text files and perform LF normalization
* text=auto

# o shell operacional roda em Linux: precisa de LF sempre
*.sh text eol=lf

# shapefiles e binarios: nunca normalizar
*.shp binary
*.shx binary
*.dbf binary
*.prj binary
*.cpg binary
*.nc  binary
*.xlsx binary

# ==========================================================
# _producao/ e espelho verbatim do servidor: fidelidade de byte
# importa mais que normalizacao. Cinco dos doze arquivos da
# producao tem CRLF, e e assim que eles rodam la; normalizar
# faria o blob commitado divergir do servidor e dos md5 do
# MANIFESTO.txt. A regra vem depois das anteriores de proposito:
# no .gitattributes vale a ultima que casar.
# ==========================================================
_producao/** -text
